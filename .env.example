TRUCE_SIGNING_IDENTITY="Developer ID Application: Your Name (1234567890)"
AUV3_SIGNING_IDENTITY="Apple Development: Your Name (1234567890)"
# Optional local macOS installer signing:
# TRUCE_INSTALLER_SIGNING_IDENTITY="Developer ID Installer: Your Name (1234567890)"
DEVELOPER_DIR="/Applications/Xcode.app/Contents/Developer"
# Apple release inputs belong in ignored .env.release, not in this file.
# Generate/update them with scripts/setup_release_secrets.py configure.
# macOS (default --platform macos):
# DEVELOPER_ID_APPLICATION_CERT_BASE64=<generated from Developer ID .p12>
# CERTIFICATE_SECRET=<Developer ID .p12 export password>
# KEYCHAIN_SECRET=<generated temporary-keychain password>
# NOTARIZE_APPLE_ID=<Apple account email>
# NOTARIZE_PASSWORD=<Apple app-specific password>
# iOS (--platform ios; Apple Distribution identity, not Developer ID):
# IOS_DISTRIBUTION_CERT_BASE64=<generated from Apple Distribution .p12>
# IOS_CERTIFICATE_PASSWORD=<Apple Distribution .p12 export password>
# IOS_ADHOC_APP_PROFILE_BASE64=<generated from app Ad Hoc profile>
# IOS_ADHOC_EXTENSION_PROFILE_BASE64=<generated from AUv3 Ad Hoc profile>
# IOS_TESTFLIGHT_APP_PROFILE_BASE64=<generated from app App Store Connect profile>
# IOS_TESTFLIGHT_EXTENSION_PROFILE_BASE64=<generated from AUv3 App Store Connect profile>
